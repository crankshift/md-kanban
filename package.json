{
  "name": "md-kanban",
  "version": "0.1.0",
  "description": "A local browser app for Markdown issues",
  "type": "module",
  "license": "MIT",
  "bin": {
    "md-kanban": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm build && node dist/server/cli.js",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -p tsconfig.server.json && vite build",
    "prepack": "pnpm typecheck && pnpm build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "prototype": "tsc -p tsconfig.server.json && vite build --mode prototype && node scripts/prototype-demo.mjs"
  },
  "dependencies": {
    "open": "^11.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@dnd-kit/react": "0.5.0",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "next-themes": "^0.4.6",
    "react-icons": "^5.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
