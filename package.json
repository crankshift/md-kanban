{
  "name": "mdboard",
  "version": "0.2.0",
  "description": "A local Markdown workspace for documents, folders, boards, and relationship maps",
  "author": "crankshift",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crankshift/md-kanban.git"
  },
  "homepage": "https://github.com/crankshift/md-kanban#readme",
  "bugs": {
    "url": "https://github.com/crankshift/md-kanban/issues"
  },
  "keywords": [
    "markdown",
    "workspace",
    "documents",
    "folders",
    "kanban",
    "graph",
    "local",
    "cli",
    "issues"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "mdboard": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm build && node dist/server/cli.js",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -p tsconfig.server.json && vite build",
    "prepack": "pnpm typecheck && pnpm build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "open": "^11.0.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@dagrejs/dagre": "3.1.1",
    "@dnd-kit/core": "6.3.1",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/d3-force": "3.0.10",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "12.12.0",
    "d3-force": "3.0.0",
    "jsdom": "^26.1.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
